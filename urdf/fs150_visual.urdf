<?xml version="1.0"?>
<!-- Viewer-only FS150. Its visual meshes, joint origins, and colors mirror the
     Gazebo fs150/iris.sdf model; dynamics and collisions intentionally stay out. -->
<robot name="fs150">
  <material name="fs150_body">
    <color rgba="0.84 0.71 0.10 1"/>
  </material>
  <material name="fs150_rotor_blue">
    <!-- Exact RViz/Lichtblick rendering equivalent generated from Gazebo/Blue
         by gazebo_sim_fs150_sitl/scripts/generate_fs150_urdf.py. -->
    <color rgba="0.1 0.2 0.9 1"/>
  </material>
  <material name="fs150_rotor_dark">
    <!-- Exact rendering equivalent generated from Gazebo/DarkGrey. -->
    <color rgba="0.12 0.12 0.12 1"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://fs150_description/meshes/iris.stl" scale="1 1 1"/>
      </geometry>
      <material name="fs150_body"/>
    </visual>
  </link>
  <link name="imu_link"/>

  <link name="rotor_0">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- Lichtblick always prefers embedded DAE materials. The equivalent
             STL keeps the Gazebo geometry while allowing this URDF color. -->
        <mesh filename="package://fs150_description/meshes/iris_prop_ccw.stl" scale="1 1 1"/>
      </geometry>
      <material name="fs150_rotor_blue"/>
    </visual>
  </link>
  <link name="rotor_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://fs150_description/meshes/iris_prop_ccw.stl" scale="1 1 1"/>
      </geometry>
      <material name="fs150_rotor_dark"/>
    </visual>
  </link>
  <link name="rotor_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://fs150_description/meshes/iris_prop_cw.stl" scale="1 1 1"/>
      </geometry>
      <material name="fs150_rotor_blue"/>
    </visual>
  </link>
  <link name="rotor_3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://fs150_description/meshes/iris_prop_cw.stl" scale="1 1 1"/>
      </geometry>
      <material name="fs150_rotor_dark"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="rotor_0_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rotor_0"/>
    <origin xyz="0.13 -0.22 0.023" rpy="0 0 0"/>
  </joint>
  <joint name="rotor_1_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rotor_1"/>
    <origin xyz="-0.13 0.2 0.023" rpy="0 0 0"/>
  </joint>
  <joint name="rotor_2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rotor_2"/>
    <origin xyz="0.13 0.22 0.023" rpy="0 0 0"/>
  </joint>
  <joint name="rotor_3_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rotor_3"/>
    <origin xyz="-0.13 -0.2 0.023" rpy="0 0 0"/>
  </joint>
</robot>
